# ==============================================================================
# LivelihoodSaathi AI - Enterprise Backend Environment Configuration
# ==============================================================================

# Server & Runtime
PORT=3000
NODE_ENV=development

# Database Configuration (Node 24 native node:sqlite DatabaseSync)
DATABASE_PATH=data/livelihoodsaathi.db

# Authentication & Security
JWT_SECRET=livelihoodsaathi-super-secret-jwt-key-2026-production

# Frontend Public Configuration
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_WS_BASE_URL=
NEXT_PUBLIC_APP_NAME="LivelihoodSaathi AI"
NEXT_PUBLIC_APP_TAGLINE="Your Skills. Your Future. Your Voice."
NEXT_PUBLIC_DEFAULT_LOCALE="ta-IN"

# ==============================================================================
# Gnani AI Enterprise Suite Credentials (Server-side ONLY, NEVER prefix NEXT_PUBLIC_)
# When keys are absent, clean adapters operate in resilient mode with full logging.
# ==============================================================================

# 1. Gnani Prisma v3.0 - Speech to Text (REST + WebSocket Streaming)
GNANI_API_KEY=
GNANI_TOKEN=
GNANI_STT_ENDPOINT=https://api.vachana.ai/stt/v3/transcribe
GNANI_WS_ENDPOINT=wss://api.vachana.ai/stt/v3/stream

# 2. Gnani Evon - 30B Reasoning Model (Multilingual Career & Skill Gap Guidance)
EVON_API_KEY=
EVON_ENDPOINT=https://api.vachana.ai/reasoning/v1/chat

# 3. Gnani Timbre v3.0 - Text to Speech (Binary WAV Synthesis)
GNANI_TTS_ENDPOINT=https://api.vachana.ai/tts/v2/synthesize

# ==============================================================================
# Google Gemini AI Integration (Official Google Generative AI SDK)
# Server-side ONLY. Used by src/services/geminiService.ts.
# When key is absent, the backend runs the built-in RAG career knowledge synthesizer.
# ==============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
